#!/bin/sh
# Remove the Kar Page launcher for this user. Does not touch the website.
set -eu

if [ "$(id -u)" -eq 0 ]; then
  echo "Run ./uninstall as your user, not root." >&2
  exit 1
fi

home=${HOME:?HOME is not set}
data=${XDG_DATA_HOME:-$home/.local/share}
config=${XDG_CONFIG_HOME:-$home/.config}
state=${XDG_STATE_HOME:-$home/.local/state}
apps=$data/applications
icons=$data/icons/hicolor/512x512/apps
hypr=$home/.config/hypr

remove_block() {
  file=$1
  if [ ! -f "$file" ] || [ -L "$file" ]; then
    return 0
  fi
  tmp=$(mktemp)
  awk '
    BEGIN { n = 0; skip = 0 }
    /karpage-omarchy:begin/ {
      if (n > 0 && buf[n] ~ /^[[:space:]]*$/) n--
      skip = 1
      next
    }
    /karpage-omarchy:end/ { skip = 0; next }
    skip { next }
    { buf[++n] = $0 }
    END {
      for (i = 1; i <= n; i++) print buf[i]
    }
  ' "$file" >"$tmp"
  mv "$tmp" "$file"
}

remove_block "$hypr/hyprland.conf"
remove_block "$hypr/hyprland.lua"

rm -f \
  "$home/.local/bin/karpage" \
  "$apps/karpage.desktop" \
  "$icons/karpage.png" \
  "$hypr/karpage.conf" \
  "$hypr/karpage.lua" \
  "$hypr/karpage_binds.lua" \
  "$hypr/karpage-binds.conf"

case $state/karpage in
  */karpage) rm -rf "$state/karpage" ;;
esac

if command -v update-desktop-database >/dev/null 2>&1; then
  update-desktop-database "$apps" || true
fi
if command -v hyprctl >/dev/null 2>&1; then
  hyprctl reload >/dev/null 2>&1 || true
fi

cat <<EOF
Kar Page launcher removed.

Left in place, because they can hold a sign-in:
  $config/karpage/config
  $data/karpage/browsers/
EOF
